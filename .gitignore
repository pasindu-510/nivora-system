# Local environment secrets — never commit real .env files.
# Templates (.env.example, .env.production.example) and the non-secret
# frontend/.env.production stay tracked.
.env

# Build artifacts / deployment bundles
deploy/

# Python
__pycache__/
*.pyc
venv/
.Venv/
*.sqlite3

# Node
node_modules/

# OS
.DS_Store
# Private uploads (customer ID photos) — never commit
backend/private_media/

# Uploaded files (logos, product images)
backend/media/
backend/staticfiles/
backend/tmp/

# Scratch output: screenshots dropped in the repo root, logs, backups, caches
/*.png
*.log
*.bak
build_out.txt
.pytest_cache/

# Local AI / browser tool data
.codegraph/
.playwright-mcp/
.omo/
