# Production environment for nivora.lk cPanel.
# Copy to backend/.env ON THE SERVER (the Passenger app root), then chmod 600.
# NEVER commit the real .env — this is a template only.

# ── Django core ────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME_run_python_-c_"from_django.core.management.utils_import_get_random_secret_key;_print(get_random_secret_key())"
DEBUG=False
ALLOWED_HOSTS=api.nivora.lk,localhost,127.0.0.1

# ── Database (cPanel MySQL: Databases → MySQL Database Wizard) ─────────────
# DB name/user are prefixed by the cPanel account: USER_shopapi / USER_shop.
DB_ENGINE=mysql
DB_NAME=CHANGE_ME_shopapi
DB_USER=CHANGE_ME_shop
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# Only if `pip install mysqlclient` fails on the shared host (build headers
# missing): install pymysql instead and uncomment the next line.
# DB_DRIVER=pymysql

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── CORS: the SPA origin (the page that calls the API cross-origin) ────────
CORS_ALLOWED_ORIGINS=https://system.nivora.lk

# ── Media / static (SAME origin as the SPA so relative /media/ URLs work) ──
# Media is served by Apache from the system.nivora.lk document root. Django
# writes there via STATIC_ROOT/MEDIA_ROOT; Apache serves it.
STATIC_ROOT=/home/CHANGE_ME/public_html/system/static
MEDIA_ROOT=/home/CHANGE_ME/public_html/system/media
# Admin/docs assets are pulled from the SPA origin because the API subdomain
# serves no static files.
STATIC_URL=https://system.nivora.lk/static/