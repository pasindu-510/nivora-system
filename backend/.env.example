# Copy to .env and adjust for your environment.

# ── Django core ────────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (omit DB_* to stay on SQLite for local/tests) ─────────────────
# DB_ENGINE=mysql
# DB_NAME=shopapi
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_CONN_MAX_AGE=60

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── CORS (React dev server, comma-separated) ───────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Media / static (production cPanel) ──────────────────────────────────────
# STATIC_ROOT=/home/USERNAME/public_html/static
# MEDIA_ROOT=/home/USERNAME/public_html/media